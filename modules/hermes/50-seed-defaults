#!/command/with-contenv sh
# shellcheck shell=sh
# shellcheck disable=SC2235,SC2015
# Seed baked-in config, SOUL, skills, and scripts on every boot.
# Then resolve any remaining ${VAR} placeholders that Hermes doesn't auto-substitute.
# Seed the baked config WITHOUT clobbering the whole live file. A raw copy
# erased the codex-router `hooks.pre_llm_call` merge at every boot, so the
# installer reported a global hook that never survived a restart. Merge, don't
# clobber: every key the baked config defines wins, and a top-level key it does
# not define (runtime-installed `hooks`, a hand-added `hooks_auto_accept`) is
# carried over.
#
# ponytail: no retired-key drop list for this merge. A key the baked config
# drops lingers in the live file until an operator removes it; Hermes ignores
# unknown keys, and the baked `mcp_servers` wins here, so a retired MCP server
# cannot survive in this file. Profile configs are different — they are only
# copied when absent, so they carry a retired-key drop list in the managed
# profile migration below. Add one here only if a retired key starts breaking
# boot.
# The merge runs as the hermes user, not root: the file it writes is born
# hermes-owned, so no chown is ever needed for it. Root only bootstraps a
# missing file (first boot, unwritable target); every later boot rewrites
# in place as hermes. A no-change merge skips the write entirely, so the
# inode and ownership survive untouched boots.
# The sealed agent venv omits PyYAML, and container python3 resolves to it, so
# every python3 block below that imports yaml needs the isolated dependency
# path. su scrubs the environment, so the hermes-user merge carries it inline.
PYTHONPATH="/opt/hermes-webui-deps${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
if [ -f /opt/data/config.yaml ]; then
    su -s /bin/sh hermes -c 'PYTHONPATH=/opt/hermes-webui-deps python3 - /opt/hermes-defaults/config.yaml /opt/data/config.yaml' <<'PYCONFIG' || echo "WARNING: hermes config merge failed; keeping the live config" >&2
import os
import shutil
import sys
from pathlib import Path

import yaml

canonical_path = Path(sys.argv[1])
live_path = Path(sys.argv[2])

canonical = yaml.safe_load(canonical_path.read_text()) or {}
carried = {}
try:
    live = yaml.safe_load(live_path.read_text()) or {}
except (OSError, UnicodeDecodeError, yaml.YAMLError) as exc:
    # An unreadable live config parses as empty, so the reseed below would
    # drop every carried key without trace. Keep a copy an operator can
    # recover the hooks from before overwriting it.
    live = {}
    backup_path = live_path.with_name(live_path.name + ".invalid")
    try:
        shutil.copyfile(live_path, backup_path)
        detail = f"backed up to {backup_path}"
    except OSError as backup_exc:
        detail = f"backup failed ({backup_exc})"
    print(f"WARNING: {live_path} is unreadable or not valid YAML ({exc}); {detail}; reseeding it", file=sys.stderr)
if isinstance(canonical, dict) and isinstance(live, dict):
    for key, value in live.items():
        if key not in canonical:
            carried[key] = value

# Write the baked bytes unchanged and graft the carried keys on the end, so the
# baked file's comments and formatting survive the merge. The memory provider
# lives in the baked config itself, so no carry is needed for it.
text = canonical_path.read_text()
if carried:
    text = text.rstrip("\n") + "\n\n" + yaml.safe_dump(carried, sort_keys=False)
try:
    existing = live_path.read_text()
except OSError:
    existing = None
if existing != text:
    # Atomic replace: a kill mid-write must not truncate the live config.
    tmp_path = live_path.with_name(live_path.name + ".tmp")
    tmp_path.write_text(text)
    os.replace(tmp_path, live_path)
    print("config: merged baked config into live config")
PYCONFIG
else
    cp /opt/hermes-defaults/config.yaml /opt/data/config.yaml
fi
[ ! -f /opt/data/SOUL.md ] && cp /opt/hermes-defaults/SOUL.md.template /opt/data/SOUL.md
mkdir -p /opt/data/skills
cp -r /opt/hermes-defaults/skills/* /opt/data/skills/
chown -R hermes:hermes /opt/data/skills 2>/dev/null || true
# codex-router owns the skills it publishes (dev-loop, code-reviewer, ...). The
# deploy stages its canonical tree at /opt/data/.codex-router-skills and this
# reconciliation replaces whatever copy an older seed or hand-install left in
# any runtime skill root. A no-op until a deploy has staged a source.
# ponytail: the canonical source lives in the codex-router repository, which is
# absent from this image's build context (deploy.yml checks it out only in the
# deploy job), so a fresh volume has these skills absent until the first deploy
# stages the tree and the next boot reconciles it. Bake the payload in only if
# codex-router ever enters the build context.
# A reconcile that refuses (partial source) or times out on the lock must not
# fail the boot, but it must not vanish either: keep stderr in the boot log so
# stale skills leave a breadcrumb instead of only being visible to the deploy.
# Truncated each boot, so the file stays bounded and still shows the latest run.
# The log path is probed with `true`, a regular command: in dash a failed
# redirection on a special builtin like `:` exits the shell outright, which
# `if` and `|| true` both fail to catch. This hook has no `set -e` of its own,
# but it runs under `with-contenv`, so the guard must hold either way. The probe
# decides only where stderr goes; the reconcile runs on either branch.
mkdir -p /opt/data/logs 2>/dev/null || true
if true 2>/opt/data/logs/codex-router-skills-sync.log; then
    /opt/hermes-defaults/scripts/sync-codex-router-skills.sh 2>>/opt/data/logs/codex-router-skills-sync.log || true
else
    /opt/hermes-defaults/scripts/sync-codex-router-skills.sh 2>/dev/null || true
fi
# seed-scripts:begin
# Prune scripts that were seeded earlier but are no longer baked into the image,
# using a manifest of what the seed installed (same idea as MANAGED_FILE in
# sync-codex-router-skills.sh). Only names listed in the previous manifest can be
# removed, so operator-added scripts survive; a first boot with no manifest
# prunes nothing; an empty baked set never prunes (looks like a broken image).
mkdir -p /opt/data/scripts
SEED_MANIFEST=/opt/data/.hermes-seeded-scripts
: > "$SEED_MANIFEST.new"
for seed_f in /opt/hermes-defaults/scripts/*; do
    [ -e "$seed_f" ] || continue
    echo "${seed_f##*/}" >> "$SEED_MANIFEST.new"
done
if [ -s "$SEED_MANIFEST.new" ] && [ -f "$SEED_MANIFEST" ]; then
    while IFS= read -r seed_old || [ -n "$seed_old" ]; do
        case "$seed_old" in ''|.|..|*/*) continue ;; esac
        grep -qxF -- "$seed_old" "$SEED_MANIFEST.new" || rm -rf -- "/opt/data/scripts/$seed_old"
    done < "$SEED_MANIFEST"
fi
# One-time cleanup of orphans that predate the manifest (never recorded, so the
# manifest cannot see them). Explicit names only, and only when the image does
# not ship that name now. Only names the image once shipped (repo history);
# files the repo never had are operator-owned and left alone.
seed_retired="log-issue-triage-worker.sh"
[ -e "/opt/hermes-defaults/scripts/$seed_retired" ] || rm -rf -- "/opt/data/scripts/$seed_retired"
cp -r /opt/hermes-defaults/scripts/* /opt/data/scripts/
chmod +x /opt/data/scripts/*.sh
mv "$SEED_MANIFEST.new" "$SEED_MANIFEST"
# seed-scripts:end

# Tier-2 topic files: durable facts that do not fit the always-on memory core.
# The agent reads them with the file tools, and the memory-approve-queue judge appends to
# them instead of holding a record that cannot fit. Seeded once; never overwritten.
mkdir -p /opt/data/memories/topics
if [ ! -f /opt/data/memories/topics/INDEX.md ]; then
    cat > /opt/data/memories/topics/INDEX.md <<'TOPICINDEX'
# Topic memory index

Durable facts that do not fit `MEMORY.md` live here, one file per domain. The agent
searches this directory before answering a recall question, and the memory-approve-queue
judge appends here when a fact cannot fit the always-on core.

Every line carries its aliases so keyword search finds it, for example:

    Groceries / supermarket / NTUC FairPrice / Cold Storage -> payee Groceries

Files:
- infra.md — hosts, containers, ports, deploy paths
- accounts.md — accounts, cards, identifiers
- expenses.md — payee and category mappings
- prefs.md — stable preferences and corrections
TOPICINDEX
fi
if [ ! -f /opt/data/memories/topics/MISSES.md ]; then
    printf '%s\n' \
        '# Recall misses' \
        '' \
        'One line per miss: date, the question asked, what could not be found, and whether' \
        'an alias on the label would have fixed it. A month of misses decides whether a' \
        'semantic index is worth adding.' \
        > /opt/data/memories/topics/MISSES.md
fi
chown -R hermes:hermes /opt/data/memories/topics 2>/dev/null || true

# Remove retired profile runtime state before seeding the managed profile set.
for retired_profile in static-analyst qa-engineer quality-assurance architect project-manager spec-auditor; do
    rm -rf "/opt/data/profiles/$retired_profile"
done

# Seed profile configs and SOUL files (idempotent — won't overwrite existing)
for profile_dir in /opt/hermes-defaults/profiles/*/; do
    [ -d "$profile_dir" ] || continue
    name=$(basename "$profile_dir")
    mkdir -p "/opt/data/profiles/$name"
    # Only seed if file doesn't already exist (preserves user edits)
    [ ! -f "/opt/data/profiles/$name/config.yaml" ] && cp "$profile_dir/config.yaml" "/opt/data/profiles/$name/config.yaml" 2>/dev/null || true
    [ ! -f "/opt/data/profiles/$name/SOUL.md" ] && cp "$profile_dir/SOUL.md" "/opt/data/profiles/$name/SOUL.md" 2>/dev/null || true
    [ ! -f "/opt/data/profiles/$name/profile.yaml" ] && cp "$profile_dir/profile.yaml" "/opt/data/profiles/$name/profile.yaml" 2>/dev/null || true

    # Register the profile with Hermes only when it does not already exist. A named profile
    # exists once its directory carries an identity marker — config.yaml, .env, SOUL.md,
    # profile.yaml, auth.json or state.db (hermes_constants._PROFILE_IDENTITY_MARKERS) — and
    # `hermes profile create` refuses that case with "A profile named '<name>' already exists"
    # (hermes_cli/profiles.py: create_profile). The copies above write those markers, so the
    # call below runs only for a target that is still identity-less.
    identity=0
    for marker in config.yaml .env SOUL.md profile.yaml auth.json state.db; do
        if [ -e "/opt/data/profiles/$name/$marker" ]; then
            identity=1
            break
        fi
    done
    if [ "$identity" -eq 0 ]; then
        su -s /bin/sh hermes -c "hermes profile create $name --no-alias" || true
    fi
done

# Set the default profile's display name. 'default' is the implicit root profile:
# its HERMES_HOME is the root itself and every stored path, cron profile field, and
# skills directory keys off that canonical id, so it is never renamed. The friendly
# label is profile.yaml display_name, which is presentation-only. This only fills an
# empty name, so an operator's own choice is never overwritten.
python3 <<'PYEOF' || true
# SEED_DEFAULT_PROFILE_DISPLAY_NAME
import os
import tempfile

import yaml

DEFAULT_PROFILE_DISPLAY_NAME = "friday"
PROFILE_META = "/opt/data/profile.yaml"

existing = {}
if os.path.exists(PROFILE_META):
    try:
        with open(PROFILE_META) as f:
            existing = yaml.safe_load(f) or {}
    except yaml.YAMLError:
        existing = {}
if not isinstance(existing, dict):
    existing = {}

if not str(existing.get("display_name") or "").strip():
    existing["display_name"] = DEFAULT_PROFILE_DISPLAY_NAME
    directory = os.path.dirname(PROFILE_META) or "."
    fd, tmp_path = tempfile.mkstemp(dir=directory, prefix=".profile.", suffix=".yaml")
    with os.fdopen(fd, "w") as f:
        yaml.safe_dump(existing, f, sort_keys=False, default_flow_style=False)
    os.replace(tmp_path, PROFILE_META)
    print("profile: default display name set to " + DEFAULT_PROFILE_DISPLAY_NAME)
else:
    print("profile: default display name already set")
PYEOF

# Migrate only routing fields for managed profiles while preserving user-owned settings.
python3 - <<'PY'
from pathlib import Path

import yaml

managed_routing_profiles = ("code-reviewer",)
for name in managed_routing_profiles:
    default_path = Path(f"/opt/hermes-defaults/profiles/{name}/config.yaml")
    target_path = Path(f"/opt/data/profiles/{name}/config.yaml")
    if not target_path.exists():
        continue
    defaults = yaml.safe_load(default_path.read_text()) or {}
    target = yaml.safe_load(target_path.read_text()) or {}
    for key in ("providers", "model", "fallback_providers"):
        if key in defaults:
            target[key] = defaults[key]
    # `agent` is migrated per-subkey rather than wholesale: the profile's other
    # agent settings stay user-owned, but reasoning_effort is part of the routing
    # contract this migration exists to enforce. Without it the effort never
    # reaches a host whose profile config already exists (the seed above only
    # copies an absent file), so a bumped effort would ship green and unused.
    default_agent = defaults.get("agent")
    if isinstance(default_agent, dict) and "reasoning_effort" in default_agent:
        agent = target.get("agent")
        if not isinstance(agent, dict):
            agent = {}
            target["agent"] = agent
        agent["reasoning_effort"] = default_agent["reasoning_effort"]
    # The moa toolset is no longer disabled anywhere: drop it from a live
    # profile's disabled_toolsets while keeping every other entry the operator
    # owns. An emptied list is removed outright so the file matches the baked
    # canonical shape (no disabled_toolsets key at all).
    agent = target.get("agent")
    if isinstance(agent, dict):
        disabled = agent.get("disabled_toolsets")
        if isinstance(disabled, list) and "moa" in disabled:
            kept = [entry for entry in disabled if entry != "moa"]
            if kept:
                agent["disabled_toolsets"] = kept
            else:
                del agent["disabled_toolsets"]
    if name == "code-reviewer":
        memory = target.get("memory")
        if not isinstance(memory, dict):
            memory = {}
            target["memory"] = memory
        memory["memory_enabled"] = False
        memory["user_profile_enabled"] = False
    # Email intake (#783) is env-enabled in every profile scope under the
    # multiplexer, so an existing live profile would keep building a second
    # adapter that loses the owner lock and reports down. Pin it off while
    # preserving any sibling platform entries the operator owns.
    if name == "code-reviewer":
        platforms = target.get("platforms")
        if not isinstance(platforms, dict):
            platforms = {}
            target["platforms"] = platforms
        intake = platforms.get("email_intake")
        if not isinstance(intake, dict):
            intake = {}
            platforms["email_intake"] = intake
        intake["enabled"] = False
    # Retired MCP servers: the seed loop above only writes a profile config that is
    # absent, so a server the baked profile dropped stayed in the live file and
    # failed its connection on every boot (ktmb-booking's container is retired).
    # A drop list rather than a general prune, so a hand-added server survives.
    retired_mcp_servers = ("ktmb-booking",)
    mcp_servers = target.get("mcp_servers")
    if isinstance(mcp_servers, dict):
        for server in retired_mcp_servers:
            mcp_servers.pop(server, None)
    target_path.write_text(yaml.safe_dump(target, sort_keys=False))
PY

# Ensure cron-run directories are owned by hermes (gateway runs as hermes)
mkdir -p /opt/data/memories-backup
chown -R hermes:hermes /opt/data/memories-backup 2>/dev/null || true

# Mnemosyne version pin (seed-owned). The provider flip itself lives in the
# baked config.yaml, so the merge writes it every boot with no carry needed.
# Verified live 2026-10-09: mnemosyne-hermes 0.7.1 + mnemosyne-memory 3.15.1
# is the working pair. 0.7.3/0.7.4 ship the P1b home-binding guard whose
# __init__ property assignment raises under any turn scope, so the provider
# can never construct in a real agent session. Pin stays until upstream
# fixes the constructor. Built-in MEMORY.md/USER.md stay ON (additive).
mkdir -p /opt/data/mnemosyne/data
chown -R hermes:hermes /opt/data/mnemosyne 2>/dev/null || true
# Pin the working pair into the durable lazy-packages target. uv resolves
# == pins without network when already installed; `|| true` keeps a pin
# failure from aborting boot (live state keeps serving).
su -s /bin/sh hermes -c 'HERMES_HOME=/opt/data timeout 300 uv pip install --target /opt/data/lazy-packages --no-deps "mnemosyne-hermes==0.7.1" >/dev/null 2>&1' || true
su -s /bin/sh hermes -c 'HERMES_HOME=/opt/data timeout 300 uv pip install --target /opt/data/lazy-packages "mnemosyne-memory[embeddings]==3.15.1" >/dev/null 2>&1' || true

# Cross-session recall (operator decision 2026-10-11). Mnemosyne reads
# cross_session only from its own config.yaml (mnemosyne.core.config
# resolve_beam_runtime; file beats env), not from Hermes' memory.mnemosyne
# keys. With the default false, a memory written in one session is invisible
# to every other. Only the one top-level line is rewritten, keeping the
# file's comments and other keys; an absent file gets just this key.
python3 <<'PYCS' || true
import os, re
path = "/opt/data/mnemosyne/config.yaml"
try:
    text = open(path, encoding="utf-8").read()
except FileNotFoundError:
    text = ""
if re.search(r"(?m)^cross_session:", text):
    new = re.sub(r"(?m)^cross_session:.*$", "cross_session: true", text)
else:
    new = text + ("" if text.endswith("\n") or not text else "\n") + "cross_session: true\n"
if new != text:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as handle:
        handle.write(new)
    os.replace(path + ".tmp", path)
    print("mnemosyne: cross_session set to true")
PYCS
chown hermes:hermes /opt/data/mnemosyne/config.yaml 2>/dev/null || true

# Wake-word engine (seed-owned): the upstream `wake-openwakeword` extra
# (pyopen-wakeword 1.1.0, pin owned upstream) lives in /opt/hermes/.venv, which is image state,
# not volume state — a fresh rebuild boots without it and /wake reports engine
# missing. Reinstall only when the import fails, so a healthy boot pays just
# the probe; `|| true` keeps an install failure from aborting boot.
if ! /opt/hermes/.venv/bin/python3 -c "import pyopen_wakeword" >/dev/null 2>&1; then
    su -s /bin/sh hermes -c 'HERMES_HOME=/opt/data timeout 300 /opt/hermes/bin/hermes pm install --extra wake-openwakeword >/dev/null 2>&1' \
        || echo "WARNING: wake-openwakeword install failed; /wake will report engine missing" >&2
fi

# Configure gh CLI authentication. The helper installs GitHub App auth when the
# App configuration is complete, and otherwise installs the scoped fallback PAT.
# The PAT arrives as a root-only secret file rather than an ambient environment
# variable, so no unrelated child process inherits it; the helper reads that file
# only when the App configuration is incomplete.
# The boot hook is the single reader: it must be a readable, non-empty regular
# file (a directory left by an earlier missing-source mount is not a PAT).
PAT=""
if [ -f /run/secrets/friday_pat ] && [ -s /run/secrets/friday_pat ] && [ -r /run/secrets/friday_pat ]; then
    PAT=$(cat /run/secrets/friday_pat)
fi

# The flat token file is retired: gh owns hosts.yml and the helper feeds the
# credential through stdin only, so clear any stale file before either branch.
rm -f /opt/data/.gh_token 2>/dev/null || true

if [ -n "${GH_APP_ID:-}${GH_APP_INSTALLATION_ID:-}${GH_APP_PRIVATE_KEY:-}" ] || [ -n "$PAT" ]; then
    # `-m` preserves the environment, so the prefix assignment reaches the
    # su'd shell and the helper; nothing needs expanding inside the quotes.
    GH_PAT="$PAT" su -m -s /bin/sh hermes -c '/opt/hermes-defaults/scripts/github-auth.sh' 2>/dev/null \
        || echo "WARNING: GitHub authentication failed at boot" >&2
else
    echo "WARNING: neither GitHub App config nor a fallback PAT secret is present; leaving gh credentials untouched" >&2
fi
unset PAT

# Rename seeded cron jobs to names that say what they do (no schedule in the
# name, so a schedule change never makes a name wrong). Runs before every seed
# block below, which match by the new name. The rename is in place: id,
# schedule, enabled flag and run history are kept. A job is renamed only when
# no job already carries the new name, so a re-added or half-migrated job is
# never duplicated or overwritten; that old job is left for an operator.
python3 <<'PYEOF' || true
import os, json, datetime
jobs_path = "/opt/data/cron/jobs.json"
RENAMES = [
    ("memory-triage", "memory-approve-queue"),
    ("mnemosyne-vacuum", "memory-mnemosyne-vacuum"),
    ("self-wiki-reminders-daily", "wiki-due-reminders"),
    ("self-wiki-maintenance-and-reminders", "wiki-finance-refresh"),
    ("self-wiki-repos-weekly", "wiki-repo-docs"),
    ("log-issue-triage", "ops-log-issues"),
    ("github-app-auth-refresh", "ops-github-token-refresh"),
    ("github-auth-refresh", "ops-github-token-refresh"),
    ("portfolio-daily-sync", "finance-portfolio-sync"),
]
try:
    with open(jobs_path) as f:
        data = json.load(f)
except FileNotFoundError:
    raise SystemExit(0)
except json.JSONDecodeError as error:
    raise SystemExit(f"refusing to rename jobs in corrupt cron jobs file: {error}")
jobs = data.get("jobs", []) if isinstance(data, dict) else data
renamed = []
for old, new in RENAMES:
    names = {j.get("name") for j in jobs if isinstance(j, dict)}
    if old not in names:
        continue
    if new in names:
        print(f"cron: {old} left as is; {new} already exists")
        continue
    next(j for j in jobs if isinstance(j, dict) and j.get("name") == old)["name"] = new
    renamed.append(f"{old} -> {new}")
if renamed:
    out = data if isinstance(data, dict) else {"jobs": jobs}
    out["updated_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    with open(jobs_path + ".tmp", "w") as f:
        json.dump(out, f, indent=2)
    os.replace(jobs_path + ".tmp", jobs_path)
    print("cron: renamed " + ", ".join(renamed))
PYEOF

# Seed ops-github-token-refresh cron job (no_agent script-only refresh).
python3 <<'PYEOF' || true
import os, json, uuid, datetime
jobs_path = "/opt/data/cron/jobs.json"
os.makedirs(os.path.dirname(jobs_path), exist_ok=True)
try:
    with open(jobs_path) as f:
        data = json.load(f)
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
except FileNotFoundError:
    jobs = []
except json.JSONDecodeError as error:
    # Never treat an unreadable file as empty: rewriting it wipes every cron job.
    raise SystemExit(f"refusing to replace corrupt cron jobs file: {error}")

wanted = {
    "name": "ops-github-token-refresh",
    "schedule": {"kind": "interval", "minutes": 15, "display": "every 15m"},
    "schedule_display": "every 15m",
    "script": "github-auth.sh",
    "no_agent": True,
    "enabled": True,
    "deliver": "local",
    "next_run_at": None,
}

found = False
for j in jobs:
    if not isinstance(j, dict):
        continue
    if j.get("name") == wanted["name"]:
        found = True
        changed = False
        if j.get("name") != wanted["name"]:
            j["name"] = wanted["name"]
            changed = True
        for key in ("schedule", "schedule_display", "script", "no_agent", "deliver"):
            if j.get(key) != wanted[key]:
                j[key] = wanted[key]
                changed = True
        if "prompt" in j:
            del j["prompt"]
            changed = True
        if "deliver_extra" in j:
            del j["deliver_extra"]
            changed = True
        if changed:
            print("cron: ops-github-token-refresh migrated to no_agent script-only 15m")
        else:
            print("cron: ops-github-token-refresh unchanged")
        break

if not found:
    jobs.append({
        "id": uuid.uuid4().hex[:12],
        **wanted,
        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    })
    print("cron: ops-github-token-refresh seeded (no_agent)")

with open(jobs_path + ".tmp", "w") as f:
    json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
os.replace(jobs_path + ".tmp", jobs_path)
PYEOF

