        "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        **DEFAULTS,
        **MANAGED,
    })
    print("cron: wiki-due-reminders seeded")
else:
    changed = [key for key, value in MANAGED.items() if existing.get(key) != value]
    for key in changed:
        existing[key] = MANAGED[key]
    # One-time move off the previous default (staggered off memory-approve-queue's 08:00 start so two agent sessions do not overlap). Only the exact legacy
    # value is rewritten, so a dashboard-chosen time is never reverted.
    LEGACY_SCHEDULE = "0 8 * * *"
    schedule = existing.get("schedule")
    if isinstance(schedule, dict) and schedule.get("expr") == LEGACY_SCHEDULE:
        existing["schedule"] = dict(DEFAULTS["schedule"])
        existing["schedule_display"] = DEFAULTS["schedule_display"]
        # Drop the instant computed from the old expr so the scheduler recomputes it;
        # a stale one is re-anchored past the first new occurrence without firing.
        existing["next_run_at"] = None
        changed.append("schedule")
    if changed:
        print("cron: wiki-due-reminders migrated: " + ", ".join(sorted(changed)))
    else:
        print("cron: wiki-due-reminders unchanged")

with open(jobs_path + ".tmp", "w") as f:
    json.dump({"jobs": jobs, "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=2)
os.replace(jobs_path + ".tmp", jobs_path)
PYEOF

