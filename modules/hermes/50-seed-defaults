if true 2>>/opt/data/logs/codex-router-skills-sync.log; then
    refresh_log=/opt/data/logs/codex-router-skills-sync.log
fi
if [ -f /run/secrets/friday_pat ] && [ -s /run/secrets/friday_pat ] && [ -r /run/secrets/friday_pat ]; then
