# =============================================================================
# Expense Tracker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All REQUIRED vars must be set; OPTIONAL vars have sensible defaults shown.

# ---------------------------------------------------------------------------
# Actual Budget API — REQUIRED
# ---------------------------------------------------------------------------
# URL of the Actual Budget server (e.g. self-hosted actual-api container)
ACTUAL_BUDGET_URL=
# Password for the Actual Budget server
ACTUAL_BUDGET_PASSWORD=
# Primary budget file name as it appears in Actual (e.g. "Example SGD")
ACTUAL_PRIMARY_BUDGET_FILE=
# Secondary budget file name (e.g. "Example MYR")
ACTUAL_SECONDARY_BUDGET_FILE=

# ---------------------------------------------------------------------------
# Currencies — REQUIRED (defaults shown)
# ---------------------------------------------------------------------------
ACTUAL_PRIMARY_CURRENCY=SGD
ACTUAL_SECONDARY_CURRENCY=MYR

# ---------------------------------------------------------------------------
# IMAP (Email) — REQUIRED
# ---------------------------------------------------------------------------
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# ---------------------------------------------------------------------------
# IMAP — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------------------
# LLM Provider — REQUIRED (one of the two options below)
# ---------------------------------------------------------------------------
# Option A: DeepSeek (default — no LLM_* vars needed)
DEEPSEEK_API_KEY=

# Option B: LiteLLM proxy (e.g. codex-router for ChatGPT subscription)
# Uncomment these and remove DEEPSEEK_API_KEY above:
# LLM_PROVIDER=litellm_proxy
# LLM_BASE_URL=http://host.docker.internal:4100/v1
# LLM_MODEL=auto-thinking
# LLM_API_KEY=local
# LLM_REASONING_EFFORT=low
# Optional second router model tried if the primary route fails (unset by default;
# the retired gpt-5.6-terra is gone). DeepSeek below stays the final fallback.
# LLM_FALLBACK_MODEL=
# LLM_FINAL_FALLBACK_PROVIDER=deepseek
# LLM_FINAL_FALLBACK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# LLM / AI — OPTIONAL
# ---------------------------------------------------------------------------
# Brave Search API key for merchant/payee resolution
# BRAVE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Actual Budget — OPTIONAL
# ---------------------------------------------------------------------------
# Encryption password if your Actual Budget file is encrypted (v2.9+)
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=

# ---------------------------------------------------------------------------
# Notifications — REQUIRED
# ---------------------------------------------------------------------------
# Hermes webhook URL for expense notifications
NOTIFY_URL=
# Secret token to authenticate incoming webhook calls
HERMES_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Logging & Personalization — OPTIONAL (defaults shown)
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# USER_NAME=there
# SYSTEM_PROMPT_EXTRA=

# ---------------------------------------------------------------------------
# Data Paths — OPTIONAL (defaults shown, relative to /app inside container)
# Paths can be overridden via environment variables when launching the container.
# ---------------------------------------------------------------------------
# DEDUP_DB_PATH=data/dedup.db
# STATEMENT_DB_PATH=data/statement.db
# MEMORY_PATH=data/MEMORY.md
