# The codex-router front. Both colours answer on 4100 inside the compose
# network; only this proxy is published, and deploy.sh rolls the colours behind
# it one at a time.
#
# `lb_policy first` picks the first healthy upstream in the order written here,
# so codex-router-a wins whenever it is healthy and a roll to `b` is a no-op for
# the front until `a` stops.
:4100 {
	# 4100 is published on every interface, so anything on the home network
	# can reach it. Docker networks (Hermes and the other modules), the host
	# itself via localhost and Tailscale serve (which proxies from 127.0.0.1)
	# arrive from loopback or a Docker bridge, and tailnet devices calling the
	# port directly from a Tailscale address (100.64.0.0/10); those pass as
	# before. Any other caller must send the router's master key (the one the
	# manager's hop edits use). An unset key matches nothing ("Bearer " is
	# never a sent value), so the LAN is refused rather than let in.
	@lan_without_token {
		not remote_ip 127.0.0.0/8 172.16.0.0/12 100.64.0.0/10
		not header Authorization "Bearer {$LITELLM_MASTER_KEY}"
	}
	respond @lan_without_token "codex-router: send the router key as a Bearer token" 401

	reverse_proxy codex-router-a:4100 codex-router-b:4100 {
		lb_policy first
		# A dial failure is retried for this long before the request fails:
		# caddy buffers the body, so a POST that lands on the colour being
		# stopped moves to the other colour instead of erroring.
		lb_try_duration 30s
		lb_try_interval 250ms
		health_uri /health/liveliness
		health_interval 10s
		health_timeout 5s
		# How long an upstream stays out of rotation after a failed check.
		fail_duration 30s
		# Stream server-sent events as they are produced instead of buffering
		# them, which would stall an in-flight response until the body ends.
		flush_interval -1
	}
}
