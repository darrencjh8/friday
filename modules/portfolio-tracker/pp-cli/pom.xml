<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>name.abuchen.portfolio.cli</groupId>
    <artifactId>pp-cli</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Portfolio Performance CLI</name>
    <description>Headless CLI tool for Portfolio Performance XML manipulation.

BUILD PREREQUISITES:
1. Build Portfolio Performance from source or download the Linux release
2. Extract name.abuchen.portfolio JAR from plugins/ folder
3. Install to local Maven: mvn install:install-file -Dfile=name.abuchen.portfolio_0.84.1.jar -DgroupId=name.abuchen.portfolio -DartifactId=name.abuchen.portfolio -Dversion=0.84.1 -Dpackaging=jar
4. Then build this CLI: mvn clean package -f pp-cli/pom.xml

The PP model JAR is not available on Maven Central.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>name.abuchen.portfolio</groupId>
            <artifactId>name.abuchen.portfolio</artifactId>
            <version>0.84.1</version>
        </dependency>
        <dependency>
            <groupId>com.thoughtworks.xstream</groupId>
            <artifactId>xstream</artifactId>
            <version>1.4.21</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.0-jre</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.osgi</artifactId>
            <version>3.21.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.equinox.common</artifactId>
            <version>3.18.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.core.runtime</artifactId>
            <version>3.31.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.30.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>pp-cli</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.17</version>
                <configuration>
                    <excludes>
                        <!-- Excluded from Surefire due to JAR signing conflict (HeadlessSave).
                             Run against shaded JAR:
                               java -cp pp-cli.jar:test-classes:junit.jar:hamcrest-core.jar \\
                                 org.junit.runner.JUnitCore PpClientUpdateBalanceTest,PpClientUpdateBalanceEdgeTest -->
                        <exclude>**/PpClientUpdateBalanceTest.java</exclude>
                        <exclude>**/PpClientUpdateBalanceEdgeTest.java</exclude>
                        <exclude>**/PpClientImportIbkrTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>name.abuchen.portfolio.cli.Main</mainClass>
                                    <manifestEntries>
                                        <Add-Opens>java.base/java.lang java.base/java.util java.base/java.lang.reflect ALL-UNNAMED</Add-Opens>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
