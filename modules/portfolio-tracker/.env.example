# ────────────────────────────────────────────────────────────────
# Portfolio Tracker — Environment Variables
# ────────────────────────────────────────────────────────────────
# Shared by: portfolio-tracker, actual-api, image-gen containers
# Copy to .env:  cp .env.example .env
#
# All other vars have sensible defaults (see src/config.js).
# ────────────────────────────────────────────────────────────────

# DeepSeek API key for LLM orchestrator (PDF trade confirmations)
DEEPSEEK_API_KEY=sk-

# Actual Budget REST API
ACTUAL_BUDGET_URL=https://your-actual-server.example.com
ACTUAL_BUDGET_PASSWORD=your-password
ACTUAL_PRIMARY_BUDGET_FILE=SGD Budget
ACTUAL_SECONDARY_BUDGET_FILE=MYR Budget

# OneDrive OAuth
ONEDRIVE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# IBKR Flex Web Service (for auto-import during sync)
# Token from Account Management → Reports → Flex Web Service
IBKR_FLEX_TOKEN=
# Flex query ID from Account Management → Reports → Flex Queries
IBKR_FLEX_QUERY_ID=
# PP account UUIDs for routing IBKR trades
IBKR_PP_SGD_ACCOUNT=
IBKR_PP_USD_ACCOUNT=
IBKR_PP_PORTFOLIO_ACCOUNT=

# Google Sheets — Taxonomy Export
# Service account JSON (inline or file path like /app/config/google-service-account.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
# Taxonomy names to export (comma-separated)
TAXONOMY_NAMES=Sector,Geography,Asset Class
# Sheet cell mapping: TaxonomyName:CellRef,... (e.g., Sector:A1,Geography:B1)
TAXONOMY_SHEET_MAPPING=

# PP account UUIDs for balance sync
PP_EMERGENCY_PRIMARY_ACCOUNT=
PP_EMERGENCY_SECONDARY_ACCOUNT=
PP_WARCHEST_PRIMARY_ACCOUNT=

# IMAP for PDF trade confirmations (leave empty to disable)
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────

# PP file encryption password (empty = no encryption)
# PP_PASSWORD=

# Semantic facts/password store (broker statement passwords, notes).
# Separate from MAPPINGS_PATH (securities/account mappings).
# PORTFOLIO_MEMORY_PATH=data/MEMORY.md

# Cache dir for the all-MiniLM embedding model (baked into the image at build).
# TRANSFORMERS_CACHE=/app/.models
